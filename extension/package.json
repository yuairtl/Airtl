{
  "name": "airtl",
  "displayName": "Airtl",
  "description": "%extension.description%",
  "version": "1.0.0-preview",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Airtl yu <yuairtl@outlook.com>",
  "icon": "icon.png",
  "publisher": "local",
  "engines": {
    "vscode": "^1.61.0"
  },
  "keywords": [
    "vivado",
    "fpga",
    "rtl",
    "verilog",
    "systemverilog",
    "vhdl",
    "hierarchy",
    "block design",
    "xilinx",
    "amd"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:verilog",
    "onLanguage:systemverilog",
    "onCommand:airtl.focus",
    "onView:vivadoProjectSource",
    "onView:vivadoProjectExplorer",
    "onView:vivadoBDTree",
    "onView:vivadoWorkflow",
    "onCommand:vivadoProjectExplorer.openBlockDesign",
    "onCommand:vivadoBD.openScope"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "verilog",
        "aliases": [
          "Verilog",
          "verilog"
        ],
        "extensions": [
          ".v",
          ".vh"
        ]
      },
      {
        "id": "systemverilog",
        "aliases": [
          "SystemVerilog",
          "systemverilog"
        ],
        "extensions": [
          ".sv",
          ".svh"
        ]
      }
    ],
    "grammars": [
      {
        "language": "verilog",
        "scopeName": "source.systemverilog.airtl",
        "path": "./syntaxes/systemverilog.tmLanguage.json"
      },
      {
        "language": "systemverilog",
        "scopeName": "source.systemverilog.airtl",
        "path": "./syntaxes/systemverilog.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "airtlPort",
        "superType": "parameter",
        "description": "Named port at a module instance connection"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "verilog",
        "scopes": {
          "macro": [
            "entity.name.function.preprocessor"
          ],
          "variable.readonly": [
            "entity.name.function.preprocessor"
          ],
          "enumMember": [
            "entity.name.function.preprocessor"
          ],
          "parameter": [
            "variable.parameter"
          ],
          "airtlPort": [
            "variable.parameter"
          ]
        }
      },
      {
        "language": "systemverilog",
        "scopes": {
          "macro": [
            "entity.name.function.preprocessor"
          ],
          "variable.readonly": [
            "entity.name.function.preprocessor"
          ],
          "enumMember": [
            "entity.name.function.preprocessor"
          ],
          "parameter": [
            "variable.parameter"
          ],
          "airtlPort": [
            "variable.parameter"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[verilog]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[systemverilog]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "airtl",
          "title": "%view.airtlContainer%",
          "icon": "./media/airtl-activity.svg"
        }
      ]
    },
    "views": {
      "airtl": [
        {
          "id": "vivadoProjectSource",
          "name": "%view.projectSource%"
        },
        {
          "id": "vivadoProjectExplorer",
          "name": "%view.projectTree%"
        },
        {
          "id": "vivadoBDTree",
          "name": "%view.bdTree%"
        },
        {
          "id": "vivadoWorkflow",
          "name": "%view.workflow%"
        }
      ]
    },
    "commands": [
      {
        "command": "airtl.focus",
        "title": "%command.openAirtl%",
        "category": "Airtl"
      },
      {
        "command": "vivadoProjectExplorer.refresh",
        "title": "%command.refreshTree%",
        "category": "Vivado",
        "icon": "$(refresh)"
      },
      {
        "command": "vivadoProjectExplorer.setProject",
        "title": "%command.setProject%",
        "category": "Vivado",
        "icon": "$(file-directory)"
      },
      {
        "command": "vivadoProjectExplorer.selectTreeSource",
        "title": "%command.scanSources%",
        "category": "Vivado",
        "icon": "$(list-selection)"
      },
      {
        "command": "vivadoProjectExplorer.reloadProject",
        "title": "%command.reloadProject%",
        "category": "Vivado",
        "icon": "$(sync)"
      },
      {
        "command": "vivadoProjectExplorer.copyPath",
        "title": "%command.copyPath%",
        "category": "Vivado"
      },
      {
        "command": "vivadoProjectExplorer.openInstance",
        "title": "%command.openInstance%",
        "category": "Vivado"
      },
      {
        "command": "vivadoProjectExplorer.openDefinition",
        "title": "%command.openDefinition%",
        "category": "Vivado"
      },
      {
        "command": "vivadoProjectExplorer.openBlockDesign",
        "title": "%command.openBlockDesign%",
        "category": "Vivado"
      },
      {
        "command": "vivadoProjectExplorer.exportSelectedFiles",
        "title": "%command.exportSelectedFiles%",
        "category": "Vivado"
      },
      {
        "command": "vivadoBD.openScope",
        "title": "%command.openScope%",
        "category": "Vivado"
      },
      {
        "command": "vivadoBD.refresh",
        "title": "%command.refreshBdTree%",
        "category": "Vivado",
        "icon": "$(refresh)"
      },
      {
        "command": "vivadoWorkflow.simulate",
        "title": "%command.simulate%",
        "category": "Vivado"
      },
      {
        "command": "vivadoWorkflow.synth",
        "title": "%command.synth%",
        "category": "Vivado"
      },
      {
        "command": "vivadoWorkflow.impl",
        "title": "%command.implement%",
        "category": "Vivado"
      },
      {
        "command": "vivadoWorkflow.bit",
        "title": "%command.bitstream%",
        "category": "Vivado"
      },
      {
        "command": "vivadoWorkflow.openWaveform",
        "title": "%command.openWaveform%",
        "category": "Vivado"
      },
      {
        "command": "vivadoProjectExplorer.explainModule",
        "title": "%command.explainModule%",
        "category": "Vivado"
      },
      {
        "command": "airtl.systemverilog.lint",
        "title": "%command.svLint%",
        "category": "Airtl"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vivadoProjectExplorer.refresh",
          "when": "view == vivadoProjectExplorer",
          "group": "navigation"
        },
        {
          "command": "vivadoProjectExplorer.setProject",
          "when": "view == vivadoProjectSource",
          "group": "navigation"
        },
        {
          "command": "vivadoProjectExplorer.reloadProject",
          "when": "view == vivadoProjectSource",
          "group": "navigation"
        },
        {
          "command": "vivadoProjectExplorer.selectTreeSource",
          "when": "view == vivadoProjectSource",
          "group": "navigation"
        },
        {
          "command": "vivadoBD.refresh",
          "when": "view == vivadoBDTree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "vivadoProjectExplorer.copyPath",
          "when": "view == vivadoProjectExplorer && viewItem == module",
          "group": "inline"
        },
        {
          "command": "vivadoProjectExplorer.openDefinition",
          "when": "view == vivadoProjectExplorer && viewItem == module",
          "group": "navigation"
        },
        {
          "command": "vivadoBD.openScope",
          "when": "view == vivadoProjectExplorer && viewItem == module",
          "group": "BD@1"
        },
        {
          "command": "vivadoProjectExplorer.explainModule",
          "when": "view == vivadoProjectExplorer && viewItem == module",
          "group": "AI@1"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "vivadoProjectExplorer.generatedIpImplementationFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Explicit generated IP implementation files to load on the next project refresh (absolute paths or paths relative to the project). Other generated netlists supply declaration boundaries only. Encrypted files and stubs remain boundaries."
        },
        "vivadoProjectExplorer.ai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.ai.enabled%"
        },
        "vivadoProjectExplorer.ai.tool": {
          "type": "string",
          "enum": [
            "claude",
            "opencode",
            "dsh",
            "zcode",
            "generic"
          ],
          "default": "opencode",
          "enumDescriptions": [
            "%config.ai.tool.claude%",
            "%config.ai.tool.opencode%",
            "%config.ai.tool.dsh%",
            "%config.ai.tool.zcode%",
            "%config.ai.tool.generic%"
          ],
          "description": "%config.ai.tool%"
        },
        "vivadoProjectExplorer.ai.autoFallback": {
          "type": "boolean",
          "default": false,
          "description": "%config.ai.autoFallback%"
        },
        "vivadoProjectExplorer.ai.dsh.command": {
          "type": "string",
          "default": "",
          "description": "%config.ai.dsh.command%"
        },
        "vivadoProjectExplorer.ai.zcode.command": {
          "type": "string",
          "default": "",
          "description": "%config.ai.zcode.command%"
        },
        "vivadoProjectExplorer.ai.generic.command": {
          "type": "string",
          "default": "",
          "description": "%config.ai.generic.command%"
        },
        "vivadoProjectExplorer.exportMode": {
          "type": "string",
          "enum": [
            "clipboard",
            "outputChannel",
            "command"
          ],
          "default": "clipboard",
          "description": "%config.exportMode%"
        },
        "vivadoProjectExplorer.exportCommand": {
          "type": "string",
          "default": "",
          "description": "%config.exportCommand%"
        },
        "airtl.systemverilog.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.sv.enabled%"
        },
        "airtl.systemverilog.intelliSense.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.sv.intelliSense%"
        },
        "airtl.systemverilog.intelliSense.debounceMs": {
          "type": "integer",
          "default": 500,
          "minimum": 100,
          "maximum": 5000,
          "description": "%config.sv.intelliSenseDebounce%"
        },
        "airtl.systemverilog.syntaxDebounceMs": {
          "type": "integer",
          "default": 250,
          "minimum": 0,
          "maximum": 5000,
          "description": "%config.sv.debounce%"
        },
        "airtl.systemverilog.dimInactiveCode": {
          "type": "boolean",
          "default": true,
          "description": "%config.sv.dimInactiveCode%"
        },
        "airtl.systemverilog.standard": {
          "type": "string",
          "enum": [
            "1800-2017",
            "1800-2023"
          ],
          "default": "1800-2017",
          "description": "%config.sv.standard%"
        },
        "airtl.systemverilog.project.fileList": {
          "type": "string",
          "default": "",
          "description": "%config.sv.fileList%"
        },
        "airtl.systemverilog.lint.mode": {
          "type": "string",
          "enum": [
            "off",
            "slang",
            "vendor",
            "both"
          ],
          "default": "slang",
          "description": "%config.sv.lintMode%"
        },
        "airtl.systemverilog.lint.vendor": {
          "type": "string",
          "enum": [
            "none",
            "vivado",
            "quartus",
            "verilator",
            "custom"
          ],
          "default": "none",
          "description": "%config.sv.vendor%"
        },
        "airtl.systemverilog.lint.vendorTrigger": {
          "type": "string",
          "enum": [
            "manual",
            "onSave"
          ],
          "default": "manual",
          "description": "%config.sv.vendorTrigger%"
        },
        "airtl.systemverilog.lint.target": {
          "type": "string",
          "enum": [
            "synthesis",
            "simulation"
          ],
          "default": "synthesis",
          "description": "%config.sv.target%"
        },
        "airtl.systemverilog.lint.toolPath": {
          "type": "string",
          "default": "",
          "description": "%config.sv.toolPath%"
        },
        "airtl.systemverilog.lint.toolArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.sv.toolArgs%"
        },
        "airtl.systemverilog.lint.timeoutMs": {
          "type": "integer",
          "default": 30000,
          "minimum": 1000,
          "maximum": 120000,
          "description": "%config.sv.timeout%"
        }
      }
    }
  }
}
